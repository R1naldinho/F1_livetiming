{
    "manifest_version": 3,
    "name": "F1 Token Sync",
    "version": "1.0.0",
    "description": "Sends your formula1.com session token to your own livetiming server whenever it changes.",
    "permissions": [
        "cookies",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://*.formula1.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "F1 Token Sync"
    }
}